{
  "name": "hth-idea-board",
  "version": "1.0.0",
  "private": true,
  "engines": { "node": ">=22.0.0" },
  "workspaces": ["worker"],
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "dev:web": "next dev --port 3000",
    "dev:worker": "npm run dev --workspace worker",
    "db:migrate": "npm run db:migrate --workspace worker",
    "build": "next build",
    "typecheck:worker": "npm run typecheck --workspace worker",
    "check": "npm run typecheck:worker && npm run build",
    "start": "next start --port 3000"
  },
  "dependencies": {
    "next": "16.1.1",
    "react": "19.3.0",
    "react-dom": "19.3.0"
  },
  "devDependencies": {
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "typescript": "^5.9.2"
  }
}
